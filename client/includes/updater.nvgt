const string dl_filename = "uw_seediffusion.zip";

// Returns the raw tag_name of the latest GitHub release, or "" on failure.
// Uses minimal string parsing so we don't pull in a JSON dependency.
string get_latest_release_tag() {
	string response = url_get("https://api.github.com/repos/seedy60/twg/releases/latest");
	if (response == "") return "";
	int pos = string_contains(response, "\"tag_name\":\"", 1);
	if (pos < 0) return "";
	string after = string_trim_left(response, pos + 12); // 12 = length of `"tag_name":"
	int end = string_contains(after, "\"", 1);
	if (end < 0) return "";
	return string_left(after, end);
}

int check_updates(bool silent = false) {
	// 0 = success, 1 = available but canceled, 2 = no update or download failed, -1 = could not reach the release API.
	if (!silent) speak("Checking for updates...");
	sound s;
	string raw_tag = get_latest_release_tag();
	if (raw_tag == "") {
		if (!silent) alert("Update", "Could not check for updates");
		return -1;
	}
	// Strip an optional leading "v" so multiversion can parse a plain numeric/dotted version.
	string l = raw_tag;
	if (string_left(l, 1) == "v") l = string_right(l, l.length() - 1);
	multiversion lv(l);
	multiversion yv(app.version);
	if (lv > yv) {
		s.load(AUDIO_DIR + "update.ogg");
		s.play();
		if (question("Update available", "A new update " + l + " is available. Download now?") == 1) {
			s.close();
			s.load(AUDIO_DIR + "updating" + random(1, 7) + ".ogg");
			s.play_looped();
			// Always pull from the /latest release alias so we don't depend on tag-name math.
			string url = "https://github.com/seedy60/twg/releases/latest/download/" + dl_filename;
			int f = dl_file(url, dl_filename);
			if (f == dl_status_done) {
				s.close();
				s.load(AUDIO_DIR + "updated.ogg");
				s.play();
				run("unzip.bat", "", false, false);
				exit();
				return 0;
			}
			s.close();
			s.load(AUDIO_DIR + "updatefail.ogg");
			s.play();
			return 2;
		}
		s.close();
		s.load(AUDIO_DIR + "update_canceled.ogg");
		s.play();
		alert("Update", "Update's canceled");
		return 1;
	}//Version
	if (!silent) alert("Update", "No updates available");
	return 2;
}//
